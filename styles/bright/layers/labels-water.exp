// Names of waterways and water bodies.

colors = import "../derive/colors.exp"
sizes = import "../derive/sizes.exp"
flags = import "../derive/visibility.exp"
text = import "../derive/label-text.json"

waterLabel = {
  "type": "symbol",
  "source": "openmaptiles",
  "source-layer": "water_name",
  "layout": {
    "text-field": text.stacked,
    "text-font": ["Noto Sans Italic"],
    "text-letter-spacing": 0.2,
    "text-max-width": 5
  },
  "paint": {
    "text-color": colors.accent,
    "text-halo-color": colors.haloWaterBody,
    "text-halo-width": 1.5
  }
}

lineLabel = {
  "symbol-placement": "line",
  "symbol-spacing": 350,
  "text-field": text.inline
}

lineGeometry = ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false]

names = [
  {
    ...waterLabel,
    "id": "waterway_line_label",
    "source-layer": "waterway",
    "minzoom": 10,
    "filter": lineGeometry,
    "layout": {
      ...waterLabel.layout,
      ...lineLabel,
      "text-size": sizes.waterway
    },
    "paint": {
      ...waterLabel.paint,
      "text-color": colors.waterwayLabel,
      "text-halo-color": colors.haloWaterway
    }
  },
  {
    ...waterLabel,
    "id": "water_name_point_label",
    "filter": ["match", ["geometry-type"], ["MultiPoint", "Point"], true, false],
    "layout": {
      ...waterLabel.layout,
      "text-size": interpolate(
        ["linear"],
        zoom(),
        0, sizes.waterBodyLow,
        8, sizes.waterBody
      )
    }
  },
  {
    ...waterLabel,
    "id": "water_name_line_label",
    "filter": lineGeometry,
    "layout": {
      ...waterLabel.layout,
      ...lineLabel,
      "text-size": sizes.waterBody
    }
  }
]

visible = flags.waterLabels

{
  "names": when { visible -> names, true -> [] }
}
